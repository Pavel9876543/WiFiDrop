APP_NAME=WiFiDrop
HOST=0.0.0.0
PORT=8000
# Относительный путь считается от корня проекта; абсолютный тоже поддерживается.
UPLOAD_DIR=Files
# Число в МБ; 0 или unlimited отключает ограничение.
MAX_FILE_SIZE_MB=2048
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_RETENTION_DAYS=30
UPLOAD_CHUNK_SIZE_KB=1024

# Captive Portal: useful only when this machine/router controls DHCP/DNS for the Wi-Fi.
CAPTIVE_PORTAL_ENABLED=false
# Connectivity checks use ordinary HTTP, normally TCP port 80.
CAPTIVE_PORTAL_PORT=80
# Optional fixed URL, e.g. http://192.168.4.1:8000/; blank = detect LAN IPv4 automatically.
CAPTIVE_PORTAL_PUBLIC_URL=

# Windows isolated hotspot mode. Run via run_hotspot.bat as Administrator.
# This mode creates its own DHCP + wildcard DNS, which is what allows phones
# to discover the captive portal instead of requiring a manually entered IP.
HOTSPOT_ENABLED=false
HOTSPOT_SSID=WiFiDrop
HOTSPOT_PASSWORD=WiFiDrop2026
HOTSPOT_GATEWAY_IP=192.168.50.1
